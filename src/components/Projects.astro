---
import { Link2, Lock } from '@lucide/astro';
import LinkButton from './LinkButton.astro';
import { TAGS, ADMIN_TOOLS, PROJECT_STATUS } from './TagsIcons.astro';
import Modal from './Modal.astro';
import ImageModal from './ImageModal.astro';

const PROJECTS = [
	{
		title: 'By Brava — Website Redesign',
		description: `Rediseño integral del sitio web de Brava, transformando los diseños visuales creados en Adobe Illustrator en una aplicación web moderna, accesible y completamente responsive.\n\nDesarrollé el frontend completo de forma independiente con Next.js, React, TypeScript y Tailwind CSS, definiendo la arquitectura de componentes reutilizables y la estructura general del proyecto.\n\nIntegré Sanity CMS para consumir y representar contenido dinámico, y construí un sistema de formularios dinámicos con múltiples tipos de campo y validación. Implementé animaciones e interacciones de interfaz con Motion y Lenis, cuidando la experiencia en todos los dispositivos.\n\nEl proyecto se gestiona dentro de un monorepo con Turborepo, integrando los componentes y paquetes del repositorio, y todo el flujo de entregas se realiza mediante Pull Requests en GitHub.`,
		link: 'https://bybrava.pt/',
		image: ['/projects/byBrava.webp'],
		tags: [TAGS.NEXT, TAGS.REACT, TAGS.TYPESCRIPT, TAGS.TAILWIND, TAGS.SANITY],
		status: PROJECT_STATUS.IN_PROGRESS,
		adminTool: ADMIN_TOOLS.VERCEL,
		modalAnimation: { animation: 'slide' as const, from: 'right' as const, duration: 500 },
		imageAnimation: { animation: 'zoom' as const, duration: 450 }
	},
	{
		title: 'AgroTraz - Gestion de Fabricas',
		description: `Desarrollo de una plataforma de gestión integral para fábricas, diseñada para optimizar la administración de recursos y procesos. La aplicación permite a los usuarios gestionar y controlar diversos aspectos de la producción, incluyendo la planificación, seguimiento y análisis de datos en tiempo real.\n
		La interfaz de usuario es intuitiva y fácil de usar, lo que facilita la navegación y el acceso a la información crítica. La plataforma incluye funcionalidades avanzadas como la generación de informes personalizados, la integración con sistemas externos y la capacidad de adaptarse a las necesidades específicas de cada fábrica.\n
		Además, se implementaron medidas de seguridad robustas para proteger la información sensible y garantizar la privacidad de los datos. La aplicación está diseñada para ser escalable y flexible, permitiendo a las fábricas crecer y adaptarse a los cambios en el mercado y en la tecnología.`,
		link: 'https://www.agrotraz.com/',
		image: ['/projects/gesfap.webp'],
		tags: [TAGS.TYPESCRIPT, TAGS.ASTRO, TAGS.REACT, TAGS.TAILWIND, TAGS.DOCKER, TAGS.MARIADB],
		status: PROJECT_STATUS.IN_PROGRESS,
		adminTool: ADMIN_TOOLS.VPS,
		modalAnimation: { animation: 'bounce' as const, duration: 700 },
		imageAnimation: { animation: 'slide' as const, from: 'top' as const, duration: 450 }
	},
	{
		title: 'Goblin Ajedrez - Juego de ajedrez online',
		description: `Plataforma de ajedrez online completamente reescrita desde cero. Evolucionó desde una aplicación básica en Python Flask hacia un stack moderno con React, Node.js y MariaDB, manteniendo una arquitectura preparada para crecer.\n
		Incluye modos de juego normales y competitivos, puzzles con diferentes modos y temáticas, cursos, perfiles personalizables con avatares, eventos, reseñas y un panel de administración completo. El sistema de pagos está integrado con Stripe.\n
		El tablero usa Chessground personalizado: redimensionable, con más de 20 skins para piezas y fondos, soporte para clic secundario (círculos, flechas y anotaciones) y una experiencia móvil cuidada. SEO, metadatos y estructura de navegación optimizados para buscadores.\n
		Infraestructura con Docker y Dokploy sobre un VPS, con despliegues independientes para frontend, backend y base de datos. La plataforma está en producción y sigue evolucionando con nuevas features y mantenimiento continuo.`,
		link: 'https://goblinajedrez.com/',
		image: ['/projects/goblinajedrez.webp', '/projects/goblinajedrez-1.webp', '/projects/goblinajedrez-2.webp'],
		tags: [TAGS.REACT, TAGS.TYPESCRIPT, TAGS.TAILWIND, TAGS.VITE, TAGS.NODE, TAGS.EXPRESS, TAGS.MARIADB],
		status: PROJECT_STATUS.IN_PROGRESS,
		adminTool: ADMIN_TOOLS.VPS,
		modalAnimation: { animation: 'slide' as const, from: 'left' as const, duration: 500 },
		imageAnimation: { animation: 'zoom' as const, duration: 550 },
		history: [
			{
				date: '2024-01-15',
				tags: [TAGS.PYTHON, TAGS.JINJA2, TAGS.HTML, TAGS.BOOTSTRAP, TAGS.SQLITE],
				description: 'Versión inicial con Python y Flask'
			},
			{
				date: '2025-12-10',
				tags: [TAGS.REACT, TAGS.TYPESCRIPT, TAGS.TAILWIND, TAGS.VITE, TAGS.NODE, TAGS.EXPRESS, TAGS.MARIADB],
				description: 'Migración completa a React + Node.js + MariaDB (en producción, en evolución)'
			}
		]
	},
	{
		title: 'ETTG',
		description: `El European Think Tanks Group (ETTG) es una red de seis think tanks europeos independientes que colaboran para proporcionar investigación y análisis innovadores sobre políticas de cooperación internacional de la UE y desarrollo sostenible global.\n\n		En este proyecto, desarrollado con WordPress, PHP, Elementor y Advanced Custom Fields, me encargo del mantenimiento y evolución continua de la plataforma: creación de un sistema de contenido relacionado mediante ACF + snippets PHP + Elementor, desarrollo y modificación de páginas y templates completas, resolución de incidencias en categorías, etiquetas y consultas dinámicas, auditoría de The Events Calendar y optimización general de la plataforma.`,
		link: 'https://ettg.eu/',
		image: ['/projects/ettg.webp'],
		tags: [TAGS.WORDPRESS, TAGS.JAVASCRIPT],
		status: PROJECT_STATUS.IN_PROGRESS,
		adminTool: ADMIN_TOOLS.WORDPRESS,
		bgColor: '#089C80',
		modalAnimation: { animation: 'zoom' as const, duration: 400 },
		imageAnimation: { animation: 'bounce' as const, duration: 700 }
	},
	{
		title: 'CMS - Incantatem',
		description: `Creación de un CMS personalizado enfocado en la gestión eficiente de archivos e imágenes. Este sistema permite a los administradores subir, editar y organizar archivos multimedia, generando metadatos en formato JSON que vinculan cada elemento con su información correspondiente.\n
		El CMS cuenta con dos vistas: una para usuarios no técnicos que facilita la visualización y modificación de datos sin necesidad de interactuar con JSON, y otra avanzada para usuarios técnicos que permite editar el JSON directamente. Además, se implementó una funcionalidad en tiempo real utilizando WebSocket, lo que permite monitorear y visualizar cambios en el stock de los elementos.\n
		Este proyecto no solo optimiza la gestión de contenido, sino que también integra características avanzadas para adaptarse a las necesidades específicas de la tienda.`,
		link: '',
		image: ['/projects/custom_cms.webp'],
		tags: [TAGS.TYPESCRIPT, TAGS.NODE, TAGS.REACT, TAGS.TAILWIND, TAGS.DOCKER],
		status: PROJECT_STATUS.COMPLETED,
		adminTool: ADMIN_TOOLS.VPS,
		modalAnimation: { animation: 'slide' as const, from: 'top' as const, duration: 450 },
		imageAnimation: { animation: 'fade' as const, duration: 600 }
	},
	{
		title: 'ESP CUSTOMS LLC',
		description:
			'Responsable de la creación y desarrollo integral de la plataforma. Diseñé y desarrollé desde cero tanto el servidor como el panel web, implementando una base de datos robusta, integración de APIs internas/externas y un sistema de eventos para la comunicación y componentización del proyecto. Mejoré la eficiencia del sistema, implementé pruebas exhaustivas y una gestión continua, logrando un despliegue eficiente y un soporte eficaz.',
		link: 'https://espcustoms.xyz',
		image: ['/projects/espcustoms.webp'],
		tags: [TAGS.TYPESCRIPT, TAGS.NODE, TAGS.ANGULAR, TAGS.BOOTSTRAP, TAGS.MONGODB],
		status: PROJECT_STATUS.COMPLETED,
		adminTool: ADMIN_TOOLS.CLOUD,
		imageAnimation: { animation: 'scale' as const, duration: 350 }
	},
	{
		title: 'Weasel Web — Web corporativa',
		description: `Mantenimiento y evolución de la página web corporativa de Weasel Web, una empresa de desarrollo de software. Trabajo sobre la base existente modificando la mayoría de las páginas y componentes, implementando mejoras visuales y funcionales, y resolviendo errores en la aplicación para mantener la web siempre alineada con la imagen y servicios actuales de la empresa.`,
		link: 'https://weaselweb.es/',
		image: ['/projects/weaselweb.webp'],
		tags: [TAGS.ASTRO, TAGS.REACT, TAGS.TYPESCRIPT, TAGS.TAILWIND],
		status: PROJECT_STATUS.COMPLETED,
		adminTool: ADMIN_TOOLS.VERCEL,
		modalAnimation: { animation: 'fade' as const, duration: 500 },
		imageAnimation: { animation: 'slide' as const, from: 'bottom' as const, duration: 450 }
	},
	{
		title: 'ESP Customs OAuth — NPM',
		description: `Librería open source publicada en NPM que simplifica la integración de Discord OAuth en aplicaciones y servicios. Desarrollada desde cero en TypeScript y Node.js, con documentación propia, tipado completo y una API sencilla que abstrae todo el flujo de autenticación OAuth2 de Discord para que cualquier desarrollador pueda añadir login con Discord en su proyecto en minutos.`,
		link: 'https://www.npmjs.com/package/esp-customs-oauth',
		image: ['/projects/esp_customs_oauth.webp'],
		tags: [TAGS.TYPESCRIPT, TAGS.NODE],
		status: PROJECT_STATUS.COMPLETED,
		adminTool: ADMIN_TOOLS.VERCEL,
		modalAnimation: { animation: 'scale' as const, duration: 400 },
		imageAnimation: { animation: 'zoom' as const, duration: 400 }
	},
	{
		title: 'AuraFut - Ecommerce',
		description: `Tienda online de productos deportivos estructurada en tres módulos: frontend de cliente, panel de administración y API. Cada componente se diseñó para ofrecer una experiencia de compra rápida, segura y escalable.\n
		Admin: panel para gestionar estadísticas, productos, pedidos y usuarios, con un sistema avanzado de subida de imágenes que transcodifica a base64 con optimización previa.\n
		Cliente: registro y login, perfiles personales, gestión de pedidos, sistema de compra con múltiples pasarelas (PayPal, Mastercard, Visa, Google Pay), buscador avanzado, filtros personalizables y una interfaz responsive cuidada.\n
		Server: API con Express, middleware de seguridad y autenticación mediante tokens. Construido con React, TypeScript, Bootstrap y MongoDB, con despliegue inicial en Heroku.\n
		La plataforma sigue operativa, aunque el sistema fue migrado posteriormente a Shopify para simplificar su mantenimiento.`,
		link: 'https://aurafut.com',
		image: ['/projects/aurafut.webp'],
		tags: [TAGS.TYPESCRIPT, TAGS.NODE, TAGS.REACT, TAGS.BOOTSTRAP, TAGS.MONGODB],
		status: PROJECT_STATUS.COMPLETED,
		adminTool: ADMIN_TOOLS.SHOPIFY,
		modalAnimation: { animation: 'fade' as const, duration: 500 },
		imageAnimation: { animation: 'slide' as const, from: 'right' as const, duration: 450 }
	},
	{
		title: 'Canvacard - NPM',
		description: `Paquete NPM que permite a los desarrolladores crear tarjetas personalizadas de forma sencilla y rápida. Canvacard ofrece una amplia gama de plantillas predefinidas y personalizables, así como la posibilidad de crear tarjetas desde cero. Los usuarios pueden añadir texto, imágenes, iconos y formas, y personalizar el diseño con colores y fuentes personalizadas.\n
		Este proyecto ha sido desarrollado con JavaScript, @napi-rs/canvas, @skyra/gifenc y con TypeScript para realizar los tipados e interfaces . Canvacard es una herramienta versátil y eficiente que permite a los desarrolladores crear tarjetas personalizadas de forma rápida y sencilla.`,
		link: 'https://canvacard.srgobi.com/',
		image: ['/projects/canvacard.webp'],
		tags: [TAGS.JAVASCRIPT, TAGS.TYPESCRIPT],
		status: PROJECT_STATUS.COMPLETED,
		adminTool: ADMIN_TOOLS.VERCEL,
		modalAnimation: { animation: 'scale' as const, duration: 400 },
		imageAnimation: { animation: 'slide' as const, from: 'left' as const, duration: 400 }
	},
	{
		title: 'App Discord Peereira7',
		description: 'Creación y gestión de una aplicación de Discord con más de 50 comandos y soporte completo para todos los eventos. Optimización en la gestión de usuarios y mensajes para mejorar la experiencia en el servidor.',
		link: 'https://discord.gg/peereira7',
		image: ['/projects/Servidor_Peereira7.webp'],
		tags: [TAGS.TYPESCRIPT, TAGS.NODE, TAGS.DISCORD, TAGS.MONGODB],
		status: PROJECT_STATUS.COMPLETED,
		adminTool: ADMIN_TOOLS.VPS,
		imageAnimation: { animation: 'zoom' as const, duration: 300 }
	},
	{
		title: 'LibertadCripto - ComuniDAO',
		description: 'Plataforma para aprender sobre dinero, cripto y web3 con el contenido que se creó. Se puede acceder a la plataforma a través de Discord y la web. Se creó un bot para el servidor de Discord que permite a los usuarios interactuar con la plataforma y obtener mucho aprendizaje. Los usuarios pueden aprender entre si en la plataforma.',
		link: 'https://www.instagram.com/libertadcripto',
		image: ['/projects/Servidor_LibertadCripto.webp'],
		tags: [TAGS.TYPESCRIPT, TAGS.NODE, TAGS.DISCORD, TAGS.MONGODB],
		status: PROJECT_STATUS.COMPLETED,
		adminTool: ADMIN_TOOLS.VPS,
		imageAnimation: { animation: 'slide' as const, from: 'bottom' as const, duration: 500 }
	}
];
---

<div class="flex flex-col gap-y-16">
	{
		PROJECTS.map(({ image, title, description, tags, link, status, adminTool, history, bgColor, modalAnimation, imageAnimation }) => (
			<article class="flex flex-col space-x-0 space-y-8 group md:flex-row md:space-x-8 md:space-y-0">
				<div class="w-full md:w-1/2">
					<div class="relative flex flex-col items-center col-span-6 row-span-5 gap-8 transition duration-500 ease-in-out transform shadow-xl overflow-clip rounded-xl sm:rounded-xl md:group-hover:-translate-y-1 md:group-hover:shadow-2xl lg:border lg:border-zinc-800 lg:hover:border-zinc-700 lg:hover:bg-zinc-800/50">
						<label for={`image-modal-toggle-${title}`} class={`cursor-pointer w-full${bgColor ? ' aspect-video flex items-center justify-center' : ''}`} style={bgColor ? `background-color: ${bgColor}` : ''}>
							<img alt={title} class={`transition duration-500 ${bgColor ? 'object-contain max-h-full p-6 md:scale-100 md:group-hover:scale-105' : 'object-cover object-top w-full h-full sm:h-full md:scale-110 md:group-hover:scale-105'}`} loading="lazy" src={image[0]} />
						</label>
					</div>
				</div>

				<div class="w-full md:w-1/2 md:max-w-lg">
					<div class="flex items-start justify-between gap-2">
						<h3 class="text-2xl font-bold text-zinc-800 dark:text-zinc-100">{title}</h3>
						<span class={`flex gap-x-1 items-center rounded-full text-xs ${status.class} py-1 px-2 whitespace-nowrap`}>
							<status.icon class="size-3" />
							{status.name}
						</span>
					</div>
					<div class="flex flex-wrap mt-2">
						{tags && tags.length > 0 && (
							<div class="w-full mb-2">
								<p class="text-xs text-zinc-600 dark:text-zinc-500 mb-1">Tecnologías:</p>
								<ul class="flex xl:flex-row flex-wrap gap-2">
									{tags.map((tag) => (
										<li>
											<span class={`flex gap-x-2 rounded-full text-xs ${tag.class} py-1 px-2 `}>
												<tag.icon class="size-4" />
												{tag.name}
											</span>
										</li>
									))}
								</ul>
							</div>
						)}
						{adminTool && (
							<div class="w-full mb-2">
								<p class="text-xs text-zinc-600 dark:text-zinc-500 mb-1">Administración:</p>
								<span class={`inline-flex gap-x-2 rounded-full text-xs ${adminTool.class} py-1 px-2`}>
									<adminTool.icon class="size-4" />
									{adminTool.name}
								</span>
							</div>
						)}
						{history && history.length > 0 && (
							<div class="w-full mb-2">
								<label for={`history-modal-toggle-${title}`} class="inline-flex items-center gap-2 text-xs text-zinc-600 dark:text-zinc-400 hover:text-zinc-800 dark:hover:text-zinc-200 cursor-pointer transition">
									📋 Ver histórico de cambios ({history.length})
								</label>
							</div>
						)}
						<div class="mt-2 text-zinc-700 dark:text-zinc-400">
							{description.length > 200 ? (
								<>
									{/* Mostramos los primeros 200 caracteres */}
									<p>{description.slice(0, 200)}...</p>
									{/* Botón para ver la descripción completa */}
									<label for={`modal-toggle-${title}`} class="flex items-center gap-2 group-hover:underline decoration-zinc-500 decoration-dotted underline-offset-4 cursor-pointer">
										Ver más detalles
										<svg width="13" height="13" stroke="currentColor" stroke-width="2" class="lucide-icon lucide lucide-arrow-up-right opacity-50 duration-200 group-hover:translate-x-[1.5px] group-hover:opacity-100" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round">
											<path d="M7 7h10v10" />
											<path d="M7 17 17 7" />
										</svg>
									</label>
									{/* Modal para la descripción completa */}
									<Modal id={`modal-toggle-${title}`} title={`Detalles de ${title}`} showFooter={true} animation={modalAnimation?.animation ?? 'scale'} from={modalAnimation?.from ?? 'top'} duration={modalAnimation?.duration ?? 350}>
										<p style={{ whiteSpace: 'pre-line' }}>{description}</p>
									</Modal>
								</>
							) : (
								<p style={{ whiteSpace: 'pre-line' }}>{description}</p>
							)}
							{/* Modal de imagen: siempre presente porque el trigger (la imagen izquierda) siempre se renderiza */}
							<ImageModal id={`image-modal-toggle-${title}`} imageSrc={image[0]} imageAlt={`Imagen ampliada de ${title}`} bgColor={bgColor} animation={imageAnimation?.animation ?? 'zoom'} from={imageAnimation?.from ?? 'top'} duration={imageAnimation?.duration ?? 350} />
						</div>
						{history && history.length > 0 && (
							<Modal id={`history-modal-toggle-${title}`} title={`📋 Histórico de Cambios - ${title}`} maxWidth="3xl" showFooter={true} animation="slide" from="right" duration={400}>
								<div class="space-y-4">
									{history.map((entry, index) => (
										<div class="border dark:border-white/10 border-zinc-300 rounded-lg p-4">
											<div class="flex items-center justify-between mb-3">
												<span class="text-sm font-semibold text-zinc-800 dark:text-zinc-200">{index === 0 ? '📅 Versión Inicial' : `📅 Actualización ${index}`}</span>
												<span class="text-xs text-zinc-600 dark:text-zinc-400">{entry.date}</span>
											</div>
											<p class="text-sm text-zinc-700 dark:text-zinc-300 mb-3">{entry.description}</p>
											<div class="flex flex-wrap gap-2">
												{entry.tags.map((tag) => (
													<span class={`flex gap-x-2 rounded-full text-xs ${tag.class} py-1 px-2`}>
														<tag.icon class="size-4" />
														{tag.name}
													</span>
												))}
											</div>
										</div>
									))}
								</div>
							</Modal>
						)}
						<footer class="flex gap-x-4 items-end justify-start mt-4">
							{link ? (
								<LinkButton href={link}>
									<Link2 class="size-4 mr-1" />
									Ir al sitio web
								</LinkButton>
							) : (
								<span class="inline-flex items-center gap-x-2 rounded-full text-xs bg-zinc-800 text-zinc-400 py-1 px-3 border border-zinc-700">
									<Lock class="size-4 mr-1" />
									Enlace privado
								</span>
							)}
						</footer>
					</div>
				</div>
			</article>
		))
	}
</div>
<script>
	document.addEventListener('DOMContentLoaded', () => {
		document.querySelectorAll<HTMLInputElement>('[data-modal-overlay]').forEach((overlay) => {
			const input = overlay.previousElementSibling as HTMLInputElement | null;
			if (input?.type === 'checkbox') {
				input.addEventListener('change', () => {
					document.body.style.overflow = input.checked ? 'hidden' : '';
				});
			}
		});
	});
</script>
