---
// Variante 3 — Bento grid con asimetría controlada.
// Primera empresa (destacada) ocupa 2x2, las siguientes 1x1.
// Cada celda muestra: header + proyecto destacado + tags. Sin proyectos = descripción larga.
import { EXPERIENCE } from '../../data/experience';
import { Building2, ArrowUpRight, Sparkles } from '@lucide/astro';
import { computeDuration } from '../../lib/dates';
import CompanyHeader from './CompanyHeader.astro';
import ProjectCard from './ProjectCard.astro';

const featuredProject = (company: { projects: Array<any> }) => (company.projects && company.projects.length > 0 ? company.projects[0] : null);
---

<div class="mt-14 space-y-12">
	{
		EXPERIENCE.map((entry) => {
			const entryDuration = computeDuration(entry.date.split('–')[0].trim(), entry.date.split('–')[1]?.trim() ?? '');
			return (
				<div>
					<header class="mb-6 flex flex-wrap items-center gap-3">
						<span class="grid place-items-center size-10 rounded-xl bg-gradient-to-br from-blue-600 to-violet-600 text-white shadow-lg shadow-blue-600/20">
							<Sparkles class="size-5" />
						</span>
						<div>
							<h3 class="text-xl md:text-2xl font-bold text-zinc-800 dark:text-zinc-100 leading-tight">{entry.title}</h3>
							<p class="mt-0.5 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-zinc-500 dark:text-zinc-400">
								<time>{entry.date}</time>
								<span class="rounded-full bg-blue-600/10 px-2 py-0.5 text-[11px] font-medium text-blue-600 dark:text-blue-400">{entryDuration}</span>
							</p>
						</div>
					</header>

					{entry.companies && entry.companies.length > 0 && (
						<ul class="grid grid-cols-1 md:grid-cols-3 gap-4 auto-rows-min">
							{entry.companies.map((company, ci) => {
								const project = featuredProject(company);
								const duration = computeDuration(company.date.split('–')[0].trim(), company.date.split('–')[1]?.trim() ?? '');
								const isFeatured = ci === 0 && !!project;
								return (
									<li
										data-exp-item
										style={`--exp-i:${ci}`}
										class={`group relative overflow-hidden rounded-2xl border p-5 exp-card-hover ${
											isFeatured ? 'md:col-span-2 md:row-span-2 border-blue-600/30 dark:border-blue-400/20 bg-gradient-to-br from-blue-600/[0.04] via-white/70 to-violet-600/[0.04] dark:from-blue-400/[0.06] dark:via-white/[0.04] dark:to-violet-400/[0.06]' : 'border-zinc-200 dark:border-white/10 bg-white/70 dark:bg-white/[0.03] backdrop-blur-sm'
										}`}
									>
										<CompanyHeader title={company.title} date={company.date} duration={duration} icon={isFeatured ? Sparkles : Building2} iconBgClass={isFeatured ? 'bg-blue-600 text-white' : 'bg-zinc-100 dark:bg-white/5'} iconColorClass={isFeatured ? 'text-white' : 'text-zinc-700 dark:text-zinc-200'} iconClass={isFeatured ? 'size-5' : 'size-4'} />

										{project ? (
											<div class="relative mt-5">
												<div class="flex items-start justify-between gap-2">
													<h5 class={`font-semibold text-zinc-800 dark:text-zinc-100 ${isFeatured ? 'text-base' : 'text-sm'}`}>{project.title}</h5>
													<ArrowUpRight class={`shrink-0 text-zinc-400 group-hover:text-blue-600 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition ${isFeatured ? 'size-5' : 'size-4'}`} />
												</div>
												<p class="mt-1 font-mono text-[11px] tracking-tight text-zinc-500 dark:text-zinc-400">{project.stack}</p>
												<p class={`mt-2 text-zinc-700 dark:text-zinc-300 ${isFeatured ? 'text-sm leading-relaxed' : 'text-xs line-clamp-3'}`}>{project.description}</p>
												{project.tags && project.tags.length > 0 && (
													<ul class="mt-3 flex flex-wrap gap-1.5">
														{project.tags.map((tag: any) => (
															<li>
																<span class={`inline-flex items-center gap-1 rounded-full font-medium text-[11px] ${tag.class} py-0.5 px-2`}>
																	<tag.icon class="size-3" />
																	{tag.name}
																</span>
															</li>
														))}
													</ul>
												)}
											</div>
										) : (
											<p class="mt-3 text-sm text-zinc-600 dark:text-zinc-400">{company.description}</p>
										)}
									</li>
								);
							})}
						</ul>
					)}
				</div>
			);
		})
	}
</div>
