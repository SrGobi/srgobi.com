---
// Card reutilizable para un proyecto dentro de una variante de experiencia.
// Muestra título, stack (font-mono), descripción y tags.
// Variantes: 'default' (con borde), 'inset' (sobre fondo tintado), 'featured' (más grande).
import { FolderGit2 } from '@lucide/astro';

interface Props {
	title: string;
	stack: string;
	description: string;
	tags?: Array<{ name: string; class: string; icon: any }>;
	variant?: 'default' | 'inset' | 'featured';
}

const { title, stack, description, tags = [], variant = 'default' } = Astro.props;

const wrapperClass =
	variant === 'inset' ? 'rounded-lg border border-zinc-200/80 dark:border-white/10 bg-zinc-50/80 dark:bg-white/5 p-4' : variant === 'featured' ? 'rounded-xl bg-gradient-to-br from-zinc-50 to-white dark:from-white/[0.04] dark:to-white/[0.02] border border-zinc-200/80 dark:border-white/10 p-5 shadow-sm' : 'rounded-lg border border-zinc-200/80 dark:border-white/10 bg-white/60 dark:bg-white/[0.03] p-4';

const titleClass = variant === 'featured' ? 'text-base font-semibold text-zinc-800 dark:text-zinc-100' : 'text-sm font-semibold text-zinc-800 dark:text-zinc-100';

const descClass = variant === 'featured' ? 'mt-2 text-sm text-zinc-700 dark:text-zinc-300' : 'mt-2 text-xs text-zinc-700 dark:text-zinc-300';
---

<div class={wrapperClass}>
	<div class="flex items-start gap-2">
		<FolderGit2 class={`mt-0.5 shrink-0 text-blue-600 ${variant === 'featured' ? 'size-5' : 'size-4'}`} />
		<h5 class={titleClass}>{title}</h5>
	</div>
	<p class="mt-1 font-mono text-zinc-500 dark:text-zinc-400 text-[11px] tracking-tight">{stack}</p>
	<p class={descClass}>{description}</p>
	{
		tags.length > 0 && (
			<ul class="mt-3 flex flex-wrap gap-1.5">
				{tags.map((tag) => (
					<li>
						<span class={`inline-flex items-center gap-1 rounded-full text-[11px] font-medium ${tag.class} py-0.5 px-2`}>
							<tag.icon class="size-3" />
							{tag.name}
						</span>
					</li>
				))}
			</ul>
		)
	}
</div>
